//@version=5
//
// 30-Minute Opening Range Breakout (ORB) — Indicator + Alert
// -----------------------------------------------------------
// Fires when ALL of the following are true:
//   1. Price breaks above the 30-min opening range high (09:30–10:00).
//   2. Current bar volume >= 1.5x the average bar volume of the opening range.
//   3. Price is above the session VWAP.
//   4. Time is within the first 2 hours of the regular session (before 11:30).
//
// Visuals:
//   - Horizontal line at the opening range high.
//   - Green triangle above the breakout bar.
//   - Light-green background while all conditions are met.
//
// Notes:
//   - Designed for intraday timeframes of 30 minutes or less (1m/5m/15m ideal).
//   - Session times use the timezone input (default: America/New_York).
//
indicator("30-Min Opening Range Breakout", shorttitle="ORB 30m", overlay=true)

// ============================== Inputs ==============================
tz      = input.string("America/New_York", "Session timezone")
volMult = input.float(1.5, "Volume multiple vs. OR average", minval = 0.1, step = 0.1)

// Session windows (HHMM-HHMM, interpreted in `tz`)
OR_SESSION       = "0930-1000"  // 30-minute opening range
BREAKOUT_SESSION = "1000-1130"  // valid breakout window: after the OR, before 11:30
RTH_SESSION      = "0930-1600"  // regular trading hours (used for drawing the OR line)

// ======================== Session detection =========================
// time() returns na when the bar is outside the given session.
inOR     = not na(time(timeframe.period, OR_SESSION, tz))
inWindow = not na(time(timeframe.period, BREAKOUT_SESSION, tz))
inRTH    = not na(time(timeframe.period, RTH_SESSION, tz))

// ====================== Opening range tracking ======================
var float orHigh   = na   // highest high of the opening range
var float orVolSum = 0.0  // total volume traded during the opening range
var int   orBars   = 0    // number of bars in the opening range

if inOR and not inOR[1]
    // First bar of the opening range — reset state for the new day
    orHigh   := high
    orVolSum := volume
    orBars   := 1
else if inOR
    // Still inside the opening range — keep accumulating
    orHigh   := math.max(orHigh, high)
    orVolSum += volume
    orBars   += 1

// Average per-bar volume of the opening range
orAvgVol = orBars > 0 ? orVolSum / orBars : na

// The range is complete once we've left the 09:30–10:00 window
orComplete = not inOR and orBars > 0 and not na(orHigh)

// ============================== VWAP ================================
sessionVwap = ta.vwap(hlc3)  // anchors/resets at the start of each session

// ============================ Conditions ============================
breakoutAboveOR = orComplete and close > orHigh                    // 1. price above OR high
volumeSurge     = not na(orAvgVol) and volume >= volMult * orAvgVol // 2. volume >= 1.5x OR average
aboveVwap       = close > sessionVwap                              // 3. price above VWAP
inFirstTwoHours = inWindow                                         // 4. 10:00–11:30 window

allConditionsMet = breakoutAboveOR and volumeSurge and aboveVwap and inFirstTwoHours

// First bar on which the full signal appears (used for the triangle marker,
// so consecutive qualifying bars don't stack repeated shapes)
breakoutBar = allConditionsMet and not allConditionsMet[1]

// ============================= Visuals ==============================
// Horizontal line at the opening range high (drawn through the trading day)
plot(inRTH and not na(orHigh) ? orHigh : na,
     title     = "Opening Range High",
     color     = color.orange,
     style     = plot.style_linebr,
     linewidth = 2)

// Green triangle above the breakout bar
plotshape(breakoutBar,
     title    = "Breakout",
     style    = shape.triangleup,
     location = location.abovebar,
     color    = color.green,
     size     = size.small)

// Light-green background while all conditions are met
bgcolor(allConditionsMet ? color.new(color.green, 85) : na, title = "All Conditions Met")

// ============================== Alert ===============================
// In the alert dialog choose this condition with frequency "Once Per Bar".
// {{ticker}}, {{close}} and {{timenow}} are filled in by TradingView.
alertcondition(allConditionsMet,
     title   = "ORB Breakout Alert",
     message = "ORB Breakout: {{ticker}} broke the 30-min opening range high — price {{close}} at {{timenow}}")
