//@version=5
//
// 30-Minute Opening Range Breakout (ORB) — Indicator + Alerts
// -----------------------------------------------------------
// LONG / breakout signal fires when ALL of the following are true:
//   1. Price wicks above the 30-min opening range high (09:30–10:00) —
//      triggers intrabar on the high, not on bar close, for faster signals.
//   2. Current bar volume >= the configured multiple of the rolling average
//      volume of the last N bars (default 1.0x of a 20-bar average).
//   3. Price is above the session VWAP.
//   4. Time is within the breakout window (default 10:00–15:30, adjustable).
//
// SHORT / breakdown signal is the mirror image:
//   1. Price wicks below the 30-min opening range low (intrabar on the low).
//   2. Same volume condition.
//   3. Price is below the session VWAP.
//   4. Same time window.
//
// Visuals:
//   - Horizontal lines at the opening range high and low.
//   - Green triangle above the breakout bar / red triangle below the breakdown bar.
//   - Light-green (long) or light-red (short) background while conditions are met.
//
// Notes:
//   - Designed for intraday timeframes of 30 minutes or less (1m/5m/15m ideal).
//   - Session times use the timezone input (default: America/New_York).
//
indicator("30-Min Opening Range Breakout v2", shorttitle="ORB v2", overlay=true)

// ========================= Timeframe guard ==========================
// The 09:30–10:00 opening range can only be built from whole bars on an
// intraday timeframe of 30 minutes or less (5m / 15m recommended).
if not timeframe.isintraday or timeframe.in_seconds() > 30 * 60
    runtime.error("ORB 30m requires an intraday timeframe of 30 minutes or less — switch the chart to 5m or 15m.")

// ============================== Inputs ==============================
tz               = input.string("America/New_York", "Session timezone (IANA name only, e.g. America/New_York)")
volMult          = input.float(1.0, "Volume multiple vs. rolling average", minval = 0.1, step = 0.1)
volLookback      = input.int(20, "Rolling average lookback (bars)", minval = 1)
breakoutSession  = input.string("1000-1530", "Breakout window, HHMM-HHMM (e.g. 1000-1230)")

// Fixed session windows (HHMM-HHMM, interpreted in `tz`)
OR_SESSION  = "0930-1000"  // 30-minute opening range — fixed by strategy definition
RTH_SESSION = "0930-1600"  // regular trading hours (used for drawing the OR line)

// ======================== Session detection =========================
// time() returns na when the bar is outside the given session.
inOR     = not na(time(timeframe.period, OR_SESSION, tz))
inWindow = not na(time(timeframe.period, breakoutSession, tz))
inRTH    = not na(time(timeframe.period, RTH_SESSION, tz))

// ====================== Opening range tracking ======================
var float orHigh = na   // highest high of the opening range
var float orLow  = na   // lowest low of the opening range
var int   orBars = 0    // number of bars seen in the opening range

if inOR and not inOR[1]
    // First bar of the opening range — reset state for the new day
    orHigh := high
    orLow  := low
    orBars := 1
else if inOR
    // Still inside the opening range — keep accumulating
    orHigh := math.max(orHigh, high)
    orLow  := math.min(orLow, low)
    orBars += 1

// The range is complete once we've left the 09:30–10:00 window
orComplete = not inOR and orBars > 0 and not na(orHigh)

// ============================== VWAP ================================
sessionVwap = ta.vwap(hlc3)  // anchors/resets at the start of each session

// ============================ Conditions ============================
// Shared conditions
// Volume baseline is a rolling average of recent bars (not the opening
// range's own average) — the OR is typically the highest-volume period of
// the day, so comparing against it makes normal breakout bars fail to
// qualify until an outsized spike occurs, delaying the signal. Using
// rollingAvgVol[1] (the average of the N bars *before* the current one)
// lets a genuine breakout bar's volume be judged against normal recent
// activity instead.
rollingAvgVol    = ta.sma(volume, volLookback)
volumeSurge      = not na(rollingAvgVol[1]) and volume >= volMult * rollingAvgVol[1]
inBreakoutWindow = inWindow  // configured breakout window

// Long / breakout
// Uses the bar's high (not close) so the signal fires on the first wick
// that pokes above the OR high, rather than waiting for the bar to close
// beyond it — important on fast/gap moves where waiting for close is late.
breakoutAboveOR = orComplete and high > orHigh    // intrabar wick above OR high
aboveVwap       = close > sessionVwap             // price above VWAP
longSignal      = breakoutAboveOR and volumeSurge and aboveVwap and inBreakoutWindow

// Short / breakdown (mirror image) — uses the bar's low for the same reason
breakdownBelowOR = orComplete and low < orLow     // intrabar wick below OR low
belowVwap        = close < sessionVwap            // price below VWAP
shortSignal      = breakdownBelowOR and volumeSurge and belowVwap and inBreakoutWindow

// First bar on which each full signal appears (used for the triangle markers,
// so consecutive qualifying bars don't stack repeated shapes)
breakoutBar  = longSignal and not longSignal[1]
breakdownBar = shortSignal and not shortSignal[1]

// ============================= Visuals ==============================
// Horizontal lines at the opening range high and low (drawn through the trading day)
plot(inRTH and not na(orHigh) ? orHigh : na,
     title     = "Opening Range High",
     color     = color.orange,
     style     = plot.style_linebr,
     linewidth = 2)

plot(inRTH and not na(orLow) ? orLow : na,
     title     = "Opening Range Low",
     color     = color.red,
     style     = plot.style_linebr,
     linewidth = 2)

// Green triangle above the breakout bar
plotshape(breakoutBar,
     title    = "Breakout",
     style    = shape.triangleup,
     location = location.abovebar,
     color    = color.green,
     size     = size.small)

// Red triangle below the breakdown bar
plotshape(breakdownBar,
     title    = "Breakdown",
     style    = shape.triangledown,
     location = location.belowbar,
     color    = color.red,
     size     = size.small)

// Background highlight while a signal's conditions are met
bgcolor(longSignal  ? color.new(color.green, 70) : shortSignal ? color.new(color.red, 70) : na,
     title = "Signal Background")

// ============================== Alerts ==============================
// In the alert dialog choose a condition with frequency "Once Per Bar".
// {{ticker}}, {{close}} and {{timenow}} are filled in by TradingView.
alertcondition(longSignal,
     title   = "ORB Breakout Alert (Long)",
     message = "ORB Breakout: {{ticker}} broke ABOVE the 30-min opening range high — price {{close}} at {{timenow}}")

alertcondition(shortSignal,
     title   = "ORB Breakdown Alert (Short)",
     message = "ORB Breakdown: {{ticker}} broke BELOW the 30-min opening range low — price {{close}} at {{timenow}}")
